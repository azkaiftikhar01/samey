{
  "name": "samey-cli",
  "version": "0.2.0",
  "description": "Is your AI-built site samey? A local CLI that audits rendered pages for generic patterns, broken behaviour, accessibility (axe-core), performance, SEO, and best practices, with evidence and a fix prompt.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azkaiftikhar01/samey.git"
  },
  "keywords": [
    "accessibility",
    "ai",
    "audit",
    "axe-core",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "design",
    "lighthouse-alternative",
    "lint",
    "performance",
    "playwright",
    "seo",
    "ui",
    "vibe-coding",
    "website"
  ],
  "author": "Azka Iftikhar",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/azkaiftikhar01/samey/issues"
  },
  "homepage": "https://github.com/azkaiftikhar01/samey#readme",
  "dependencies": {
    "axe-core": "^4.14.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "samey": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
